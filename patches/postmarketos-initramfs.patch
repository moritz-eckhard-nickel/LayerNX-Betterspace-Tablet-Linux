diff --git a/main/postmarketos-initramfs/shim-losetup b/main/postmarketos-initramfs/shim-losetup
new file mode 100644
index 0000000000..ceaad17bec
--- /dev/null
+++ b/main/postmarketos-initramfs/shim-losetup
@@ -0,0 +1,25 @@
+#!/bin/sh
+# moritz-betterspace-v5x: Busybox-Ersatz fuer util-linux losetup in Stufe 1
+show=0; part=""; free=0; file=""
+while [ $# -gt 0 ]; do
+	case "$1" in
+		--show) show=1 ;;
+		-Pf|-fP) part="-P"; free=1 ;;
+		-P) part="-P" ;;
+		-f) free=1 ;;
+		--direct-io=*) ;;
+		--sector-size) shift ;;
+		-d) shift; exec busybox losetup -d "$1" ;;
+		-*) ;;
+		*) file="$1" ;;
+	esac
+	shift
+done
+if [ -n "$file" ]; then
+	dev="$(busybox losetup -f)" || exit 1
+	busybox losetup $part "$dev" "$file" || exit 1
+	[ "$show" = 1 ] && echo "$dev"
+	exit 0
+fi
+[ "$free" = 1 ] && exec busybox losetup -f
+exec busybox losetup -a
