diff --git a/main/postmarketos-initramfs/shim-blkid b/main/postmarketos-initramfs/shim-blkid
new file mode 100644
index 0000000000..58e470ade9
--- /dev/null
+++ b/main/postmarketos-initramfs/shim-blkid
@@ -0,0 +1,13 @@
+#!/bin/sh
+# moritz-betterspace-v5x: Busybox-Ersatz fuer util-linux blkid in Stufe 1
+# (der MT8168-Bootloader verkraftet nur ~1,9 MB unkomprimierte Ramdisk).
+# initramfs-extra bringt danach das echte blkid mit.
+case "$1" in
+	--uuid) exec busybox findfs "UUID=$2" ;;
+	--label) exec busybox findfs "LABEL=$2" ;;
+	--match-token)
+		k="${2%%=*}"; v="${2#*=}"
+		busybox blkid | grep -F "$k=\"$v\""
+		;;
+	*) exec busybox blkid "$@" ;;
+esac
