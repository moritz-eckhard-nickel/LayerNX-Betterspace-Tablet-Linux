# Maintainer: moritz-v5x <noreply@example.org>
pkgname=layernx-tastatur
pkgver=1
pkgrel=2
pkgdesc="LayerNX-Tablet-Linux: Bildschirmtastatur (QWERTZ, Umschalt/Feststelltaste, automatisch ein/aus)"
url="https://github.com/moritz-eckhard-nickel/LayerNX-Betterspace-Tablet-Linux"
arch="aarch64"
license="MIT"
options="!check"
depends="at-spi2-core dbus font-dejavu"
makedepends="gtk+3.0-dev at-spi2-core-dev libx11-dev libxtst-dev"
source="layernx-tastatur.c"

build() {
	${CC:-gcc} $CFLAGS -Wall -O2 -o layernx-tastatur "$srcdir"/layernx-tastatur.c \
		$(pkg-config --cflags --libs gtk+-3.0 atspi-2 x11 xtst) $LDFLAGS
}
package() {
	install -Dm755 layernx-tastatur "$pkgdir"/usr/bin/layernx-tastatur
}
sha512sums="
