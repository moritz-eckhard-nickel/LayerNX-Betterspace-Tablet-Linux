# Maintainer: moritz-v5x <noreply@example.org>
pkgname=layernx-webapps
pkgver=1
pkgrel=7
pkgdesc="LayerNX-Tablet-Linux: Web-Apps (Chromium, eigene Profile), Power-Tasten-Regeln mit PIN"
url="https://github.com/moritz-eckhard-nickel/LayerNX-Betterspace-Tablet-Linux"
arch="aarch64"
license="MIT"
options="!check"
depends="chromium zenity xprop xdotool font-noto webkit2gtk-4.1"
makedepends="webkit2gtk-4.1-dev gtk+3.0-dev"
source="layernx-webapp layernx-powerkey layernx-webview.c layernx-pinpad.c layernx-pin"

build() {
	${CC:-gcc} $CFLAGS -Wall -O2 -o layernx-pinpad "$srcdir"/layernx-pinpad.c $(pkg-config --cflags --libs gtk+-3.0) $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -O2 -o layernx-webview "$srcdir"/layernx-webview.c $(pkg-config --cflags --libs webkit2gtk-4.1 gtk+-3.0) $LDFLAGS
}
package() {
	install -Dm755 "$srcdir"/layernx-webapp "$pkgdir"/usr/bin/layernx-webapp
	install -Dm755 layernx-pinpad "$pkgdir"/usr/bin/layernx-pinpad
	install -Dm755 layernx-webview "$pkgdir"/usr/bin/layernx-webview
	install -Dm755 "$srcdir"/layernx-pin "$pkgdir"/usr/bin/layernx-pin
	install -Dm755 "$srcdir"/layernx-powerkey "$pkgdir"/usr/bin/layernx-powerkey
}
