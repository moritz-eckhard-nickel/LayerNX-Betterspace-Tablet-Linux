# Maintainer: moritz-v5x <noreply@example.org>
# Alpine-Paket + LayerNX-Patch: schnelle gekachelte 90-Grad-Drehung (Betterspace V5x, Panel hochkant)
pkgname=moritz-xf86-video-fbdev
_realname=xf86-video-fbdev
pkgver=0.5.0
pkgrel=1
provides="xf86-video-fbdev=$pkgver-r100"
replaces="xf86-video-fbdev"
builddir="$srcdir/$_realname-$pkgver"
pkgdesc="fbdev video driver with LayerNX fast tiled rotation (Betterspace V5x)"
url="https://www.x.org"
arch="all"
license="MIT"
makedepends="xorg-server-dev libxi-dev util-macros xorgproto"
source="https://www.x.org/releases/individual/driver/$_realname-$pkgver.tar.bz2
	fix-build.patch
	layernx-fast-rotate.patch
	"

prepare() {
	default_prepare
	update_config_sub
}

build() {
	export CFLAGS="${CFLAGS/-fno-plt}"
	export CXXFLAGS="${CXXFLAGS/-fno-plt}"
	export LDFLAGS="$LDFLAGS -Wl,-z,lazy"
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir"/usr/share/man
}

