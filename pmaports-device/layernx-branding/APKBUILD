# Maintainer: moritz-v5x <noreply@example.org>
# Branding fuer LayerNX-Tablet-Linux: Boot-Animation (Maskottchen Scribbles), Hintergrundbild
pkgname=layernx-branding
pkgver=1
pkgrel=5
pkgdesc="LayerNX-Tablet-Linux branding (boot animation, wallpaper)"
url="https://github.com/moritz-eckhard-nickel/LayerNX-Betterspace-Tablet-Linux"
arch="noarch"
license="LicenseRef-LayerNX-Artwork"
options="!check"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	layernx-bootanim.tar
	layernx-background.png
	layernx-os-release
	scribbles.txt
	fastfetch-config.jsonc
	layernx-fastfetch.sh
	layernx-hostname.initd
	layernx-erststart.initd
	10-layernx.conf
"

package() {
	mkdir -p "$pkgdir"/usr/share/layernx/bootanim
	tar -xf "$srcdir"/layernx-bootanim.tar -C "$pkgdir"/usr/share/layernx/bootanim
	install -Dm644 "$srcdir"/layernx-os-release "$pkgdir"/usr/share/layernx/os-release
	install -Dm644 "$srcdir"/scribbles.txt "$pkgdir"/usr/share/layernx/scribbles.txt
	install -Dm644 "$srcdir"/fastfetch-config.jsonc "$pkgdir"/usr/share/layernx/fastfetch.jsonc
	install -Dm644 "$srcdir"/layernx-fastfetch.sh "$pkgdir"/etc/bash/bashrc.d/layernx-fastfetch.sh
	install -Dm644 "$srcdir"/layernx-fastfetch.sh "$pkgdir"/etc/profile.d/layernx-fastfetch.sh
	install -Dm755 "$srcdir"/layernx-hostname.initd "$pkgdir"/etc/init.d/layernx-hostname
	install -Dm755 "$srcdir"/layernx-erststart.initd "$pkgdir"/etc/init.d/layernx-erststart
	install -Dm644 "$srcdir"/10-layernx.conf "$pkgdir"/etc/ssh/sshd_config.d/10-layernx.conf
	install -Dm644 "$srcdir"/layernx-background.png "$pkgdir"/usr/share/layernx/background.png
}
