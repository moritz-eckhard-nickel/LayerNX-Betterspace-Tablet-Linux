{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/layernx/scribbles.txt",
    "color": { "1": "97" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;73;49;253", "title": "38;2;73;49;253" },
    "key": { "width": 11 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;73;49;253mLayerNX-Tablet-Linux\u001b[0m" },
    "separator",
    { "type": "os", "key": "System" },
    { "type": "host", "key": "Geraet" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Laufzeit" },
    { "type": "packages", "key": "Pakete" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Display" },
    { "type": "cpu", "key": "CPU" },
    { "type": "memory", "key": "RAM" },
    { "type": "disk", "key": "Speicher", "folders": "/" },
    { "type": "localip", "key": "IP", "showIpv6": false, "showMac": false },
    { "type": "command", "key": "Akku", "text": "moritz-v5x-status akku" },
    "break",
    "colors"
  ]
}
