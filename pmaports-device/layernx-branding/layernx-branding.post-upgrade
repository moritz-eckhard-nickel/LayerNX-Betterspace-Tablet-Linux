#!/bin/sh
# os-release von LayerNX-Tablet-Linux setzen (Original bleibt in /usr/lib/os-release)
rm -f /etc/os-release
cp /usr/share/layernx/os-release /etc/os-release
for u in $(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd); do
	[ -x /bin/bash ] && sed -i "s|^\($u:.*:\)/bin/[a-z]*sh$|\1/bin/bash|" /etc/passwd
done
rc-update add layernx-hostname boot 2>/dev/null
rc-update add layernx-erststart boot 2>/dev/null
# Standard-root-Passwort "lnx" einmalig setzen, falls root gesperrt ist (aenderbar in Einstellungen -> Geraet).
# Hinweis: pmbootstrap sperrt root danach wieder (passwd -l) -> layernx-erststart setzt "lnx" beim ersten Start erneut.
# SSH-Login als root mit Passwort ist erlaubt (/etc/ssh/sshd_config.d/10-layernx.conf: PermitRootLogin yes).
if [ ! -f /etc/layernx/root-pw-gesetzt ]; then
	case "$(grep '^root:' /etc/shadow | cut -d: -f2)" in
		'!'|'*'|'!!'|'') echo 'root:lnx' | chpasswd ;;
	esac
	mkdir -p /etc/layernx; touch /etc/layernx/root-pw-gesetzt
fi
exit 0
