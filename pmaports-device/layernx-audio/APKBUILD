# Maintainer: moritz-v5x <noreply@example.org>
pkgname=layernx-audio
pkgver=1
pkgrel=3
pkgdesc="LayerNX-Tablet-Linux: Mikrofon und Lautsprecher (MT8168/MT6357) fuer alle Programme ueber PulseAudio"
url="https://github.com/moritz-eckhard-nickel/LayerNX-Betterspace-Tablet-Linux"
arch="noarch"
license="MIT"
options="!check"
builddir="$srcdir"
makedepends="python3"
depends="alsa-utils alsa-plugins-pulse pulseaudio pulseaudio-alsa pulseaudio-utils gst-plugins-base gst-plugins-good"
install="$pkgname.post-install $pkgname.post-upgrade"
source="layernx-audio.initd layernx-audio.confd layernx-pulse.initd layernx.pa asound.conf"

build() {
	# kurzer Testton (zwei weiche Toene, 48 kHz Stereo)
	python3 - <<'PY'
import math, struct, wave
w = wave.open("ton-test.wav", "wb"); w.setnchannels(2); w.setsampwidth(2); w.setframerate(48000)
d = bytearray()
for f, l in ((659.25, 0.22), (987.77, 0.38)):
    n = int(48000 * l)
    for i in range(n):
        env = min(1, i / 480) * math.exp(-4 * i / n)
        v = int(14000 * env * math.sin(2 * math.pi * f * i / 48000))
        d += struct.pack("<hh", v, v)
w.writeframes(bytes(d)); w.close()
PY
}

package() {
	install -Dm755 "$srcdir"/layernx-audio.initd "$pkgdir"/etc/init.d/layernx-audio
	install -Dm644 "$srcdir"/layernx-audio.confd "$pkgdir"/etc/conf.d/layernx-audio
	install -Dm755 "$srcdir"/layernx-pulse.initd "$pkgdir"/etc/init.d/layernx-pulse
	install -Dm644 "$srcdir"/layernx.pa "$pkgdir"/etc/pulse/layernx.pa
	install -Dm644 "$srcdir"/asound.conf "$pkgdir"/etc/asound.conf
	install -Dm644 ton-test.wav "$pkgdir"/usr/share/layernx/ton-test.wav
}
