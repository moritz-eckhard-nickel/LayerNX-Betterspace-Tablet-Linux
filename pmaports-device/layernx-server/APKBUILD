# Maintainer: moritz-v5x <noreply@example.org>
# Server-/Admin-Ausstattung fuer LayerNX-Tablet-Linux: Shell, Basiswerkzeuge,
# Tailscale und cloudflared (vorinstalliert, NICHT aktiviert), Update- und Display-Befehle.
pkgname=layernx-server
pkgver=1
pkgrel=3
_cfver=2026.11.1
pkgdesc="LayerNX-Tablet-Linux server tools (bash, tailscale, cloudflared, layernx-update)"
url="https://github.com/moritz-eckhard-nickel/LayerNX-Betterspace-Tablet-Linux"
arch="aarch64"
license="MIT AND Apache-2.0"
options="!check !strip"
install="$pkgname.post-install $pkgname.post-upgrade"
depends="bash bash-completion coreutils curl wget rsync htop nano less tmux git openssh-sftp-server ca-certificates tailscale tailscale-openrc"
source="
	layernx-update
	layernx-display
	layernx-display.confd
	layernx-akku
	layernx-akkuschutz.initd
	layernx-akkuschutz.confd
	layernx-akkuwaechter.initd
	layernx-akkuwaechter.confd
	cloudflared-$_cfver::https://github.com/cloudflare/cloudflared/releases/download/$_cfver/cloudflared-linux-arm64
"

package() {
	install -Dm755 "$srcdir"/layernx-update "$pkgdir"/usr/bin/layernx-update
	install -Dm755 "$srcdir"/layernx-display "$pkgdir"/usr/bin/layernx-display
	install -Dm755 "$srcdir"/layernx-akku "$pkgdir"/usr/bin/layernx-akku
	install -Dm755 "$srcdir"/layernx-akkuschutz.initd "$pkgdir"/etc/init.d/layernx-akkuschutz
	install -Dm644 "$srcdir"/layernx-akkuschutz.confd "$pkgdir"/etc/conf.d/layernx-akkuschutz
	install -Dm755 "$srcdir"/layernx-akkuwaechter.initd "$pkgdir"/etc/init.d/layernx-akkuwaechter
	install -Dm644 "$srcdir"/layernx-akkuwaechter.confd "$pkgdir"/etc/conf.d/layernx-akkuwaechter
	install -Dm644 "$srcdir"/layernx-display.confd "$pkgdir"/etc/conf.d/layernx-display
	install -Dm755 "$srcdir"/cloudflared-$_cfver "$pkgdir"/usr/bin/cloudflared
}
