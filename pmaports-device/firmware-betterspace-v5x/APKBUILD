pkgname=firmware-betterspace-v5x
pkgver=1
pkgrel=0
pkgdesc="Betterspace V5x connsys firmware (from device)"
arch="aarch64"
url="https://nura.eco"
license="proprietary"
options="!strip !check !archcheck !tracedeps"
source="
	soc1_0_patch_mcu_1a_1_hdr.bin
	soc1_0_ram_bt_1a_1_hdr.bin
	soc1_0_ram_mcu_1a_1_hdr.bin
	soc1_0_ram_wifi_1a_1_hdr.bin
	WIFI_RAM_CODE_soc1_0_1a_1.bin
	WMT_SOC.cfg
"

package() {
	for f in $source; do
		install -Dm644 "$srcdir"/$f "$pkgdir"/usr/lib/firmware/postmarketos/$f
	done
}
