# Maintainer: moritz-v5x <noreply@example.org>
pkgname=layernx-second-screen
pkgver=1
pkgrel=4
pkgdesc="LayerNX-Tablet-Linux: Second Screen - Tablet als Miracast-Bildschirm fuer Windows (Win+K), ohne gemeinsames WLAN"
url="https://github.com/moritz-eckhard-nickel/LayerNX-Betterspace-Tablet-Linux"
arch="aarch64"
license="MIT"
options="!check"
depends="python3 wpa_supplicant wpa_supplicant-openrc busybox-extras iw gst-plugins-base gst-plugins-good gst-plugins-bad gst-libav"
makedepends="gstreamer-dev gst-plugins-base-dev libx11-dev"
source="layernx-wfd-anzeige.c layernx-wfd-rtsp.py layernx-second-screen-p2p.py layernx-second-screen.initd layernx-second-screen.confd"

build() {
	${CC:-gcc} $CFLAGS -Wall -O3 -o layernx-wfd-anzeige "$srcdir"/layernx-wfd-anzeige.c \
		$(pkg-config --cflags --libs gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0 x11) -lpthread $LDFLAGS
}
package() {
	install -Dm755 layernx-wfd-anzeige "$pkgdir"/usr/bin/layernx-wfd-anzeige
	install -Dm755 "$srcdir"/layernx-wfd-rtsp.py "$pkgdir"/usr/libexec/layernx/layernx-wfd-rtsp.py
	install -Dm755 "$srcdir"/layernx-second-screen-p2p.py "$pkgdir"/usr/libexec/layernx/layernx-second-screen-p2p.py
	install -Dm755 "$srcdir"/layernx-second-screen.initd "$pkgdir"/etc/init.d/layernx-second-screen
	install -Dm644 "$srcdir"/layernx-second-screen.confd "$pkgdir"/etc/conf.d/layernx-second-screen
}
