#!/sbin/openrc-run
# LayerNX Second Screen: Tablet als drahtloser Bildschirm (Miracast) fuer Windows (Win+K).
# Wi-Fi Direct parallel zum normalen WLAN -> kein gemeinsames Netz noetig.
# Ein/aus: Einstellungen -> Second Screen (oder rc-update add/del layernx-second-screen).
description="LayerNX: Second Screen (Miracast-Empfaenger fuer Win+K)"
supervisor=supervise-daemon
command=/usr/bin/python3
command_args="-u /usr/libexec/layernx/layernx-second-screen-p2p.py"
output_log=/run/layernx-second-screen/daemon.log
error_log=/run/layernx-second-screen/daemon.log
respawn_delay=5
R=/run/layernx-second-screen

depend() { need moritz-v5x-wifi; after layernx-pulse moritz-v5x-xsession wpa_supplicant; }

start_pre() {
	checkpath -d -m 0755 $R
	checkpath -d -o root:wheel -m 0750 $R/wpa
	# MediaTek-Treiber legt das P2P-Interface erst im P2P-Modus an
	if [ ! -e /sys/class/net/p2p0 ]; then
		echo P > /dev/wmtWifi || return 1
		i=0; while [ ! -e /sys/class/net/p2p0 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
		[ -e /sys/class/net/p2p0 ] || { eerror "p2p0 fehlt"; return 1; }
	fi
	cat > $R/p2p.conf <<C
ctrl_interface=$R/wpa
ctrl_interface_group=wheel
update_config=0
device_name=$(hostname)
device_type=7-0050F204-1
manufacturer=LayerNX
model_name=LayerNX-Tablet-Linux
config_methods=pbc display keypad virtual_push_button
p2p_go_intent=15
persistent_reconnect=1
country=DE
C
	ip link set p2p0 up
	start-stop-daemon --start --pidfile $R/wpa.pid --exec /sbin/wpa_supplicant -- \
		-B -P $R/wpa.pid -D nl80211 -i p2p0 -c $R/p2p.conf -s || return 1
	sleep 2
}

stop_post() {
	pkill -f "layernx-wfd-rtsp[.]py" 2>/dev/null
	pkill -x layernx-wfd-anz 2>/dev/null
	pkill -f "second-screen/dhcp[.]conf" 2>/dev/null
	[ -S $R/wpa/p2p0 ] && wpa_cli -p $R/wpa -i p2p0 p2p_group_remove "*" >/dev/null 2>&1
	start-stop-daemon --stop --pidfile $R/wpa.pid --exec /sbin/wpa_supplicant 2>/dev/null
	return 0
}
