# Maintainer: moritz-v5x <noreply@example.org>
pkgname=moritz-v5x-tools
pkgver=1
pkgrel=0
pkgdesc="Betterspace V5x: Touch-Bruecke und Framebuffer-Refresher"
url="https://nura.eco"
arch="aarch64"
license="MIT"
options="!check"
makedepends="linux-headers"
install="$pkgname.post-install"
source="
	moritz-v5x-touch.c
	moritz-v5x-fbrefresh.c
	moritz-v5x-touch.initd
	moritz-v5x-fbrefresh.initd
"

build() {
	${CC:-gcc} $CFLAGS -Wall -O2 -o moritz-v5x-touch "$srcdir"/moritz-v5x-touch.c $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -O2 -o moritz-v5x-fbrefresh "$srcdir"/moritz-v5x-fbrefresh.c $LDFLAGS
}

package() {
	install -Dm755 moritz-v5x-touch "$pkgdir"/usr/bin/moritz-v5x-touch
	install -Dm755 moritz-v5x-fbrefresh "$pkgdir"/usr/bin/moritz-v5x-fbrefresh
	install -Dm755 "$srcdir"/moritz-v5x-touch.initd "$pkgdir"/etc/init.d/moritz-v5x-touch
	install -Dm755 "$srcdir"/moritz-v5x-fbrefresh.initd "$pkgdir"/etc/init.d/moritz-v5x-fbrefresh
}
