# Maintainer: moritz-v5x <noreply@example.org>
pkgname=moritz-v5x-tools
pkgver=1
pkgrel=11
pkgdesc="Betterspace V5x: Touch-Bruecke und Framebuffer-Refresher"
url="https://nura.eco"
arch="aarch64"
license="MIT"
options="!check"
makedepends="linux-headers libpng-dev"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	moritz-v5x-touch.c
	moritz-v5x-fbrefresh.c
	moritz-v5x-touch.initd
	moritz-v5x-fbrefresh.initd
	moritz-v5x-bootanim.c
	moritz-v5x-bootanim.initd
	moritz-v5x-keys.c
	moritz-v5x-keys.initd
	moritz-v5x-powermenu
	powermenu.csv
	powermenu.rc
"

build() {
	${CC:-gcc} $CFLAGS -Wall -O2 -o moritz-v5x-touch "$srcdir"/moritz-v5x-touch.c $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -O2 -o moritz-v5x-bootanim "$srcdir"/moritz-v5x-bootanim.c $LDFLAGS -lpng
	${CC:-gcc} $CFLAGS -Wall -O2 -o moritz-v5x-keys "$srcdir"/moritz-v5x-keys.c $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -O2 -o moritz-v5x-fbrefresh "$srcdir"/moritz-v5x-fbrefresh.c $LDFLAGS
}

package() {
	install -Dm755 moritz-v5x-touch "$pkgdir"/usr/bin/moritz-v5x-touch
	install -Dm755 moritz-v5x-fbrefresh "$pkgdir"/usr/bin/moritz-v5x-fbrefresh
	install -Dm755 moritz-v5x-bootanim "$pkgdir"/usr/bin/moritz-v5x-bootanim
	install -Dm755 moritz-v5x-keys "$pkgdir"/usr/bin/moritz-v5x-keys
	install -Dm755 "$srcdir"/moritz-v5x-keys.initd "$pkgdir"/etc/init.d/moritz-v5x-keys
	install -Dm755 "$srcdir"/moritz-v5x-powermenu "$pkgdir"/usr/bin/moritz-v5x-powermenu
	install -Dm644 "$srcdir"/powermenu.csv "$pkgdir"/usr/share/moritz-v5x/powermenu.csv
	install -Dm644 "$srcdir"/powermenu.rc "$pkgdir"/usr/share/moritz-v5x/powermenu.rc
	install -Dm755 "$srcdir"/moritz-v5x-bootanim.initd "$pkgdir"/etc/init.d/moritz-v5x-bootanim
	install -Dm755 "$srcdir"/moritz-v5x-touch.initd "$pkgdir"/etc/init.d/moritz-v5x-touch
	install -Dm755 "$srcdir"/moritz-v5x-fbrefresh.initd "$pkgdir"/etc/init.d/moritz-v5x-fbrefresh
}
