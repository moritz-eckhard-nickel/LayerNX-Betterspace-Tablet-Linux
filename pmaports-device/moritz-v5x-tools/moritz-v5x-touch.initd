#!/sbin/openrc-run
description="Betterspace V5x: Touch-Bruecke (mtk-tpd Typ-A -> sauberes uinput-Geraet)"
supervisor=supervise-daemon
command=/usr/bin/moritz-v5x-touch
respawn_delay=2
respawn_max=0
depend() {
	need moritz-v5x-devnodes
	before moritz-v5x-xsession
}
start_post() {
	i=0
	while [ $i -lt 30 ]; do
		for n in /sys/class/input/event*; do
			case "$(cat $n/device/name 2>/dev/null)" in
				moritz-v5x-touch) mdev -s; ln -sf /dev/input/$(basename $n) /dev/input/moritz-touch; t=1 ;;
				moritz-v5x-touch-gesten) mdev -s; ln -sf /dev/input/$(basename $n) /dev/input/moritz-gestures; g=1 ;;
			esac
		done
		[ -n "$t" ] && [ -n "$g" ] && return 0
		sleep 0.2; i=$((i+1))
	done
	ewarn "uinput-Geraet nicht gefunden"
}
