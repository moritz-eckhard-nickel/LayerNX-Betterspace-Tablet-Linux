# Maintainer: moritz-v5x <noreply@example.org>
pkgname=moritz-v5x-desktop
pkgver=1
pkgrel=17
pkgdesc="Schlanke Touch-Oberflaeche (Xorg fbdev + Openbox + tint2 + svkbd) fuer das Betterspace V5x"
url="https://nura.eco"
arch="noarch"
license="MIT"
options="!check"
depends="
	doas
	font-dejavu
	jgmenu
	openbox
	svkbd
	tint2
	xf86-input-evdev
	moritz-xf86-video-fbdev
	xhost
	xinit
	xinput
	xorg-server
	xset
	xsetroot
	xrdb
	xterm
	xmessage
	adwaita-icon-theme
	moritz-v5x-tools
	layernx-branding
	feh
	layernx-server
	lxterminal
	fastfetch
	layernx-webapps
	procps
"
install="$pkgname.post-install"
source="
	10-moritz-v5x.conf
	moritz-v5x-xsession.initd
	session-as-user
	moritz-v5x-session
	moritz-v5x-keyboard
	jgmenu-append.csv
	jgmenurc
	tint2rc
	openbox-rc.xml
	moritz-v5x-doas.conf
	moritz-v5x-power
	Xresources
	moritz-v5x-status
	layernx-themerc
	lxterminal.conf
"

package() {
	install -Dm644 "$srcdir"/10-moritz-v5x.conf "$pkgdir"/etc/X11/xorg.conf.d/10-moritz-v5x.conf
	install -Dm755 "$srcdir"/moritz-v5x-xsession.initd "$pkgdir"/etc/init.d/moritz-v5x-xsession
	install -Dm755 "$srcdir"/session-as-user "$pkgdir"/usr/libexec/moritz-v5x/session-as-user
	install -Dm755 "$srcdir"/moritz-v5x-session "$pkgdir"/usr/bin/moritz-v5x-session
	install -Dm755 "$srcdir"/moritz-v5x-status "$pkgdir"/usr/bin/moritz-v5x-status
	install -Dm755 "$srcdir"/moritz-v5x-power "$pkgdir"/usr/bin/moritz-v5x-power
	install -Dm755 "$srcdir"/moritz-v5x-keyboard "$pkgdir"/usr/bin/moritz-v5x-keyboard
	install -Dm644 "$srcdir"/jgmenu-append.csv "$pkgdir"/usr/share/moritz-v5x/jgmenu-append.csv
	install -Dm644 "$srcdir"/jgmenurc "$pkgdir"/usr/share/moritz-v5x/jgmenurc
	install -Dm644 "$srcdir"/layernx-themerc "$pkgdir"/usr/share/themes/LayerNX/openbox-3/themerc
	install -Dm644 "$srcdir"/lxterminal.conf "$pkgdir"/usr/share/moritz-v5x/lxterminal.conf
	install -Dm644 "$srcdir"/Xresources "$pkgdir"/usr/share/moritz-v5x/Xresources
	install -Dm644 "$srcdir"/tint2rc "$pkgdir"/usr/share/moritz-v5x/tint2rc
	install -Dm644 "$srcdir"/openbox-rc.xml "$pkgdir"/usr/share/moritz-v5x/openbox-rc.xml
	install -Dm600 "$srcdir"/moritz-v5x-doas.conf "$pkgdir"/etc/doas.d/moritz-v5x.conf
}
