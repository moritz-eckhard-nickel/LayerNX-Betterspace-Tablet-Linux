#!/sbin/openrc-run
# Startet Xorg (als root, kein logind) und die Openbox-Sitzung als Benutzer.
description="Betterspace V5x: grafische Oberflaeche (Xorg + Openbox)"
supervisor=supervise-daemon
command=/usr/bin/xinit
command_args="/usr/libexec/moritz-v5x/session-as-user -- /usr/bin/Xorg :0 vt1 -sharevts -novtswitch -keeptty -nocursor -nolisten tcp -logfile /var/log/Xorg.0.log"
respawn_delay=5
respawn_max=0

depend() {
	need moritz-v5x-devnodes localmount
	after moritz-v5x-wifi moritz-v5x-bootanim
}

start_pre() {
	# Boot-Animation: Stopp anfordern, sie endet fruehestens nach dem ersten kompletten Durchlauf
	touch /run/moritz-v5x-bootanim.stop
	i=0
	while [ -e /run/moritz-v5x-bootanim.pid ] && kill -0 "$(cat /run/moritz-v5x-bootanim.pid)" 2>/dev/null && [ $i -lt 150 ]; do
		sleep 0.1; i=$((i+1))
	done
	return 0
}
