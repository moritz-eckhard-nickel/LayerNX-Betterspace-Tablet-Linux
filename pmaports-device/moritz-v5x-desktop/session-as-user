#!/bin/sh
# Laeuft als Client von xinit (root) und startet die Sitzung als Erst-Benutzer.
U="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' /etc/passwd)"
[ -n "$U" ] || U=root
xhost +si:localuser:"$U" >/dev/null 2>&1
# Pan erledigt moritz-v5x-fbrefresh (zusaetzlicher Pan hier schadet nicht)
( sleep 2; echo 0,0 > /sys/class/graphics/fb0/pan ) 2>/dev/null &
exec su -l "$U" -c "DISPLAY=:0 exec /usr/bin/moritz-v5x-session"
