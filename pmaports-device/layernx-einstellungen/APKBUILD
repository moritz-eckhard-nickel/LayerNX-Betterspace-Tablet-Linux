# Maintainer: moritz-v5x <noreply@example.org>
pkgname=layernx-einstellungen
pkgver=1
pkgrel=4
pkgdesc="LayerNX-Tablet-Linux: Touch-Einstellungen (WLAN, Display, Geraet, Akku, Dienste, System)"
url="https://github.com/moritz-eckhard-nickel/LayerNX-Betterspace-Tablet-Linux"
arch="aarch64"
license="MIT"
options="!check"
depends="wpa_supplicant layernx-server layernx-webapps"
makedepends="gtk+3.0-dev"
source="layernx-einstellungen.c layernx-einstellungen-helfer"

build() {
	${CC:-gcc} $CFLAGS -Wall -O2 -o layernx-einstellungen "$srcdir"/layernx-einstellungen.c $(pkg-config --cflags --libs gtk+-3.0) $LDFLAGS
}

package() {
	install -Dm755 layernx-einstellungen "$pkgdir"/usr/bin/layernx-einstellungen
	install -Dm755 "$srcdir"/layernx-einstellungen-helfer "$pkgdir"/usr/bin/layernx-einstellungen-helfer
}
