#!/bin/sh
# Root-Aktionen fuer layernx-einstellungen (per doas nopass nur dieses Skript)
[ "$(id -u)" = 0 ] || exec doas /usr/bin/layernx-einstellungen-helfer "$@"
case "$1" in
	hostname)
		n="$2"
		case "$n" in ''|*[!A-Za-z0-9-]*|-*) echo "Ungültiger Hostname (nur A-Z, a-z, 0-9, -)" >&2; exit 2 ;; esac
		[ ${#n} -le 63 ] || { echo "Hostname zu lang" >&2; exit 2; }
		echo "$n" > /etc/hostname
		if grep -q "^127.0.1.1" /etc/hosts; then sed -i "s/^127\.0\.1\.1 .*/127.0.1.1 $n/" /etc/hosts; else echo "127.0.1.1 $n" >> /etc/hosts; fi
		hostname "$n"; mkdir -p /etc/layernx; touch /etc/layernx/hostname-vergeben
		# Second Screen meldet sich unter dem Hostnamen -> neu starten, falls aktiv
		rc-service layernx-second-screen status >/dev/null 2>&1 && rc-service layernx-second-screen restart >/dev/null 2>&1
		echo "Hostname: $n" ;;
	ssh)
		case "$2" in
			an) rc-update add sshd default >/dev/null; rc-service sshd start ;;
			aus) rc-update del sshd default >/dev/null; rc-service sshd stop ;;
		esac ;;
	tailscale)
		case "$2" in
			start) rc-update add tailscale default >/dev/null; rc-service tailscale start ;;
			stop) tailscale down 2>/dev/null; rc-service tailscale stop; rc-update del tailscale default >/dev/null ;;
			up) timeout 25 tailscale up --timeout=20s 2>&1 | grep -o "https://[^ ]*" | head -1 ;;
			status) rc-service tailscale status >/dev/null 2>&1 && tailscale status 2>&1 | head -3 || echo "gestoppt" ;;
		esac ;;
	passwort)
		# Passwort kommt ueber stdin (nie als Argument -> nicht in der Prozessliste)
		case "$2" in
			root) u=root ;;
			benutzer) u="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' /etc/passwd)"; [ -n "$u" ] || u=root ;;
			*) echo "benutzer|root" >&2; exit 2 ;;
		esac
		IFS= read -r pw
		[ -n "$pw" ] || { echo "Leeres Passwort" >&2; exit 2; }
		printf '%s:%s\n' "$u" "$pw" | chpasswd && echo "Passwort für $u geändert" ;;
	second-screen)
		case "$2" in
			an) rc-update add layernx-second-screen default >/dev/null; rc-service layernx-second-screen start >/dev/null 2>&1 && echo "Second Screen an" ;;
			aus) rc-update del layernx-second-screen default >/dev/null 2>&1; rc-service layernx-second-screen stop >/dev/null 2>&1; echo "Second Screen aus" ;;
			vergessen) rm -f /etc/layernx/second-screen-pc
				rc-service layernx-second-screen status >/dev/null 2>&1 && rc-service layernx-second-screen restart >/dev/null 2>&1
				echo "Rechner vergessen – der nächste, der sich verbindet, wird gemerkt" ;;
			status) rc-service layernx-second-screen status >/dev/null 2>&1 && echo an || echo aus ;;
			*) echo "second-screen an|aus|vergessen|status" >&2; exit 2 ;;
		esac ;;
	zertifikat)
		# Zertifikat/Schluessel fuer Firmen-WLAN nach /etc/wpa_supplicant/certs kopieren (nur root lesbar)
		q="$2"; [ -f "$q" ] || { echo "Datei nicht gefunden: $q" >&2; exit 2; }
		case "$q" in *.pem|*.crt|*.cer|*.der|*.key|*.p12|*.pfx) ;; *) echo "Nur .pem .crt .cer .der .key .p12 .pfx" >&2; exit 2 ;; esac
		[ "$(stat -c %s "$q")" -le 1048576 ] || { echo "Datei zu groß" >&2; exit 2; }
		d=/etc/wpa_supplicant/certs; mkdir -p $d; chmod 700 $d
		n=$(basename "$q" | tr -c 'A-Za-z0-9._\n-' '_')
		cp "$q" "$d/$n" && chmod 600 "$d/$n" && echo "$d/$n" ;;
	zertifikate) ls -1 /etc/wpa_supplicant/certs 2>/dev/null ;;
	*) echo "usage: hostname NAME | ssh an|aus | tailscale start|stop|up|status | passwort benutzer|root | second-screen an|aus|vergessen|status | zertifikat DATEI | zertifikate" >&2; exit 2 ;;
esac
