# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: moritz-v5x <noreply@example.org>
pkgname=device-betterspace-v5x
pkgdesc="Betterspace V5x / LANIX Ilium Pad X8 (MT8168B)"
pkgver=1
pkgrel=4
url="https://nura.eco"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	busybox-mdev-openrc
	firmware-betterspace-v5x
	linux-betterspace-v5x
	mdev-conf
	mkbootimg
	moritz-wmt-launcher
	postmarketos-base
	unudhcpd
	wireless-tools
	wpa_supplicant
	wpa_supplicant-openrc
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	moritz-v5x-devnodes.initd
	moritz-v5x-wifi.initd
	moritz-v5x-wifi.confd
	moritz-v5x-usbnet.initd
	moritz-v5x-groups.start
	modules-load.conf
	moritz-v5x-initrd.hook
	kernel-cmdline.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/moritz-v5x-devnodes.initd "$pkgdir"/etc/init.d/moritz-v5x-devnodes
	install -Dm755 "$srcdir"/moritz-v5x-wifi.initd "$pkgdir"/etc/init.d/moritz-v5x-wifi
	install -Dm644 "$srcdir"/moritz-v5x-wifi.confd "$pkgdir"/etc/conf.d/moritz-v5x-wifi
	install -Dm755 "$srcdir"/moritz-v5x-usbnet.initd "$pkgdir"/etc/init.d/moritz-v5x-usbnet
	install -Dm755 "$srcdir"/moritz-v5x-groups.start "$pkgdir"/etc/local.d/moritz-v5x-groups.start
	install -Dm755 "$srcdir"/moritz-v5x-initrd.hook "$pkgdir"/usr/share/boot-deploy/hooks/50-moritz-v5x-initrd
	install -Dm644 "$srcdir"/kernel-cmdline.conf "$pkgdir"/usr/lib/kernel-cmdline.d/50-betterspace-v5x.conf
	install -Dm644 "$srcdir"/modules-load.conf "$pkgdir"/etc/modules-load.d/00-betterspace-v5x.conf
}
