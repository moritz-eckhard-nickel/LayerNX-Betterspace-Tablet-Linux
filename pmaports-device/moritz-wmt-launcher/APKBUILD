# Maintainer: moritz-v5x <noreply@example.org>
pkgname=moritz-wmt-launcher
pkgver=1
pkgrel=0
pkgdesc="Replacement for MediaTek wmt_loader/wmt_launcher (MT8168 connsys)"
arch="aarch64"
url="https://nura.eco"
license="GPL-2.0-only"
options="!check"
source="moritz-wmt-launcher.c"

build() {
	${CC:-gcc} $CFLAGS -Wall -O2 -o moritz-wmt-launcher "$srcdir"/moritz-wmt-launcher.c $LDFLAGS
}

package() {
	install -Dm755 moritz-wmt-launcher "$pkgdir"/usr/sbin/moritz-wmt-launcher
}
