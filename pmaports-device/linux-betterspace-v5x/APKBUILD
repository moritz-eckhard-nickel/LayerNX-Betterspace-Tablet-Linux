# Maintainer: moritz-v5x <noreply@example.org>
# Stock-Kernel (Linux 4.14.141, Clang 9) aus dem boot.img des Geraets
# (LANIX Ilium Pad X8 / Betterspace V5x, Android 10, Build Pad_X8_TELCEL_SW_02).
# Binaerpaket: die passenden Quellen (Panel ili9881c_wd101hbm40ab, Touch CST1xx)
# sind nicht oeffentlich. Module + DT-Tabelle stammen vom selben Geraet.
pkgname=linux-betterspace-v5x
pkgver=4.14.141
pkgrel=4
pkgdesc="Betterspace V5x / LANIX Ilium Pad X8 stock kernel (prebuilt)"
arch="aarch64"
_flavor="betterspace-v5x"
url="https://github.com/AtillaTokmak/kernel_casper_mt8168"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:kconfigcheck-none"
makedepends="kmod"
depends="kmod"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	stock-Image.gz
	stock-dt-table.img
	config-stock.aarch64
	wmt_drv.ko
	wmt_chrdev_wifi.ko
	wlan_drv_gen4m.ko
	bt_drv.ko
"

package() {
	install -Dm644 "$srcdir"/stock-Image.gz "$pkgdir"/boot/vmlinuz
	install -Dm644 "$srcdir"/stock-dt-table.img \
		"$pkgdir"/boot/dtbs/mediatek/betterspace-v5x-stock.dtb
	install -Dm644 "$srcdir"/config-stock.aarch64 \
		"$pkgdir"/boot/config-$_flavor
	for m in wmt_drv wmt_chrdev_wifi wlan_drv_gen4m bt_drv; do
		install -Dm644 "$srcdir"/$m.ko \
			"$pkgdir"/usr/lib/modules/$pkgver/extra/$m.ko
	done
	for m in wmt_drv wmt_chrdev_wifi wlan_drv_gen4m bt_drv; do
		echo "extra/$m.ko" >> "$pkgdir"/usr/lib/modules/$pkgver/modules.order
	done
	: > "$pkgdir"/usr/lib/modules/$pkgver/modules.builtin
	: > "$pkgdir"/usr/lib/modules/$pkgver/modules.builtin.modinfo
	depmod -b "$pkgdir"/usr $pkgver
	mkdir -p "$pkgdir"/usr/share/kernel/$_flavor
	echo "$pkgver" > "$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
